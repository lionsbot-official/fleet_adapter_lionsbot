# Copy this file to .env and replace the placeholder values.
# Load it before starting the fleet adapter:
#   set -a; source .env; set +a

# Required: LionsBot API credentials
LIONSBOT_USER=replace-with-your-lionsbot-username
LIONSBOT_PASSWORD=replace-with-your-lionsbot-password

# Fleet/Docker settings
FOLDER_NAME=office_new
FLEET_1_CONFIG=config_r5.yaml
FLEET_1_NAV_GRAPH=0.yaml
FLEET_2_CONFIG=config_r3scp.yaml
FLEET_2_NAV_GRAPH=1.yaml
SERVER_URI=ws://127.0.0.1:8000/_internal

# ROS settings
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
USE_SIM_TIME=false

# RMF Web API
RMF_WEB_ALERTS_URL=http://127.0.0.1:8000/alerts/request
RMF_WEB_API_TOKEN="generated JWT here"
