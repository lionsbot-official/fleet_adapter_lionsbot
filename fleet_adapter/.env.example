# Copy this file to .env and replace the placeholder values.
# Load it before starting the fleet adapter:
#   set -a; source .env; set +a

# Required: LionsBot API credentials
LIONSBOT_USER=replace-with-your-lionsbot-username
LIONSBOT_PASSWORD=replace-with-your-lionsbot-password
# The LionsBot API of your region, for the setup script in tools/lb_rmf_setup/
LIONSBOT_API_BASE_URL=https://api.lionsbot.io

# Fleet/Docker settings
FOLDER_NAME=office_new
# Optional: the building file maps/<FOLDER_NAME>/<RMF_MAP_NAME>.building.yaml
# (default rmf_<FOLDER_NAME>) and the level RViz shows first (default L8).
# RMF_MAP_NAME=rmf_office_new
# RMF_FLOOR_NAME=L8
# Optional: true starts a mock lift adapter with RMF. Only for a test at a site
# with no real lift adapter.
# MOCK_LIFTS=false
FLEET_1_CONFIG=config_r5.yaml
FLEET_1_NAV_GRAPH=0.yaml
# FLEET_2_CONFIG=config_r3scp.yaml
# FLEET_2_NAV_GRAPH=1.yaml
SERVER_URI=ws://127.0.0.1:8000/_internal

# ROS settings
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Optional: your own Cyclone DDS config, for example to pick a network card.
# CYCLONEDDS_URI='<CycloneDDS>...</CycloneDDS>'
USE_SIM_TIME=false

# RMF Web API
# Optional. Without RMF_WEB_ALERTS_URL, the adapter uses /alerts/request on the
# server of SERVER_URI. Without RMF_WEB_API_TOKEN, it sends no alerts.
# RMF_WEB_ALERTS_URL=http://127.0.0.1:8000/alerts/request
# RMF_WEB_API_TOKEN=
# Can be regenerated for default settings:
# export RMF_WEB_API_TOKEN="$(
# python3 - <<'PY'
# import time
# import jwt

# now = int(time.time())
# print(jwt.encode(
#     {
#         "iss": "stub",
#         "aud": "rmf_api_server",
#         "preferred_username": "admin",
#         "iat": now,
#         "exp": now + 86400,
#     },
#     "rmfisawesome",
#     algorithm="HS256",
# ))
# PY
# )"