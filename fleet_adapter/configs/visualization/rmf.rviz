  Height: 1043
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  SchedulePanel:
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1774
  X: 2706
  Y: 0
